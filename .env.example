# Local setup creates .local/runtime.env. Never commit real credentials.
HOST=127.0.0.1
PORT=3002
SPACETIME_URI=ws://127.0.0.1:3001
SPACETIME_DATABASE=kalpi-local
# SPACETIME_SERVICE_TOKEN=
# Hosted creators:
# SPACETIME_AUTH_CLIENT_ID=
SPACETIME_AUTH_AUTHORITY=https://auth.spacetimedb.com/oidc
# Private Vercel Blob uses BLOB_STORE_ID + deployment OIDC.
# Local migration can use a freshly pulled VERCEL_OIDC_TOKEN.
# BLOB_STORE_ID=
# SELLER_TOKEN=
AI_PROVIDER=openai
OPENAI_MODEL=gpt-5-mini
# OPENAI_API_KEY=
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Higher-quality visual interpretation; ordinary chat model is configured separately.
OPENAI_VISION_MODEL=gpt-5.4

# Server-side image-to-3D generation only. Never expose in browser/plugin bundles.
FAL_KEY=
