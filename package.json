{
  "name": "kalpi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --env-file-if-exists=.local/runtime.env --test --test-concurrency=1 tests/*.test.js",
    "sample": "node scripts/sample.js",
    "build": "node scripts/build.mjs",
    "start:local": "node --env-file=.local/runtime.env server.js",
    "setup:local": "node scripts/setup-local.mjs",
    "generate": "scripts/spacetime.sh generate --lang typescript --out-dir src/module_bindings --module-path spacetimedb -y",
    "test:browser": "playwright test",
    "migrate": "node --env-file=.local/runtime.env scripts/migrate.mjs"
  },
  "dependencies": {
    "@google/model-viewer": "^4.4.0",
    "@vercel/blob": "^2.8.2",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "oidc-client-ts": "^3.5.0",
    "qrcode": "^1.5.4",
    "spacetimedb": "^2.13.0",
    "three": "^0.183.2",
    "zod": "^4.6.7",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "^4.6.7"
    }
  }
}
